{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConsGHost mod metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version"],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "files": {"type": ["array", "null"], "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  },
  "properties": {
    "schemaVersion": {"const": 1, "default": 1},
    "id": {"$ref": "#/$defs/id"},
    "name": {"type": "string", "minLength": 1},
    "version": {"$ref": "#/$defs/version"},
    "description": {"type": "string"},
    "author": {"type": "string"},
    "enabled": {"type": "boolean", "default": true},
    "loadAsSubprocess": {"type": "boolean", "default": false},
    "managedAssemblies": {"$ref": "#/$defs/files"},
    "nativeLibraries": {"$ref": "#/$defs/files"},
    "ignoredAddons": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\:*?\"<>|]+$"}},
    "loadAfter": {"type": "array", "items": {"$ref": "#/$defs/id"}},
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "minVersion": {"anyOf": [{"$ref": "#/$defs/version"}, {"type": "null"}]},
          "maxVersionExclusive": {"anyOf": [{"$ref": "#/$defs/version"}, {"type": "null"}]},
          "optional": {"type": "boolean", "default": false}
        }
      }
    }
  }
}
