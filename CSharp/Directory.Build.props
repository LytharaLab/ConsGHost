<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CghProductVersion>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../VERSION').Trim())</CghProductVersion>
    <Version>$(CghProductVersion)</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Prevent managed assemblies and app hosts from recording the build machine's symbol paths. -->
    <DebugType>none</DebugType>
  </PropertyGroup>
  <Target Name="ValidateCghProductVersion" BeforeTargets="GetAssemblyVersion">
    <PropertyGroup>
      <_CghVersionFormatValid>$([System.Text.RegularExpressions.Regex]::IsMatch('$(CghProductVersion)', '^(0|[1-9][0-9]{0,4})\.(0|[1-9][0-9]{0,4})\.(0|[1-9][0-9]{0,4})$'))</_CghVersionFormatValid>
    </PropertyGroup>
    <Error Condition="'$(_CghVersionFormatValid)' != 'True'"
           Text="VERSION must contain a stable major.minor.patch version with no leading zeros." />
    <Error Condition="$([System.Version]::Parse('$(CghProductVersion)').Major) &gt; 65534 Or $([System.Version]::Parse('$(CghProductVersion)').Minor) &gt; 65534 Or $([System.Version]::Parse('$(CghProductVersion)').Build) &gt; 65534"
           Text="VERSION components must be at most 65534." />
  </Target>
</Project>
